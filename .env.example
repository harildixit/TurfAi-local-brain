# No secrets or production data are committed. LocalBrain is the default.
FIRESTORE_ENABLED=false
USE_LOCAL_GEMINI_HYBRID=false

# Optional Gemini evidence (never full Gemini/OpenRouter prediction).
GEMINI_API_KEY=

# Enable Firestore reads only when configured. Prefer a dedicated Viewer
# service account; never copy production writer credentials into this repo.
FIREBASE_PROJECT_ID=
FIRESTORE_CACHE_COLLECTION=turfai-cache-v1
GOOGLE_APPLICATION_CREDENTIALS=

# Public REST read fallback if the project's rules allow it.
FIREBASE_API_KEY=

# Optional Racing API fallback if Firestore has no suitable cards.
RACING_API_USERNAME=
RACING_API_PASSWORD=
